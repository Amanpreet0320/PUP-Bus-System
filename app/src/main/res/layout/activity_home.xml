<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="40dp"
        android:paddingBottom="110dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- ================= HEADER ================= -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="82dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUP Bus System"
                        android:textColor="#173B78"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Welcome, Student!"
                        android:textColor="#697586"
                        android:textSize="17sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="end|top"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="true"
                    android:contentDescription="Profile"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:padding="15dp"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </FrameLayout>

            <!-- ================= SMALL EMERGENCY NOTICE BANNER ================= -->
            <LinearLayout
                android:id="@+id/layoutNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFEBEE"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:elevation="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚨 Emergency Notice – Tap to read"
                    android:textColor="#C62828"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#C62828"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= BUS SERVICES ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="                      Bus Services"
                android:textColor="#202B3C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- ================= ROW 1 ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardBusStops"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="#EAF2FF"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#E5EFFF"
                        android:gravity="center"
                        android:text="🚌"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Bus Stops"
                        android:textColor="#202B3C"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Find your stop"
                        android:textColor="#8993A4"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBusTiming"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#F2EAFF"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#E7F8EF"
                        android:gravity="center"
                        android:text="🕐"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Bus Timing"
                        android:textColor="#202B3C"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Check schedule"
                        android:textColor="#8993A4"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= ROW 2 ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardDriverDetails"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="#FFF3E5"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#FFF1E3"
                        android:gravity="center"
                        android:text="👨‍✈️"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Driver Details"
                        android:textColor="#202B3C"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Driver information"
                        android:textColor="#8993A4"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardBusDetails"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#EAF8F0"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#F0E8FF"
                        android:gravity="center"
                        android:text="🚍"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Bus Details"
                        android:textColor="#202B3C"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Bus information"
                        android:textColor="#8993A4"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= PASS DETAILS ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardPassDetails"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="#FFEAF2"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#FFE0EC"
                        android:gravity="center"
                        android:text="🎫"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pass Details"
                        android:textColor="#202B3C"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="View pass information"
                        android:textColor="#8993A4"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ================= FIXED HELP CENTER ================= -->
    <TextView
        android:id="@+id/tvHelpCenter"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="25dp"
        android:background="#173B78"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center"
        android:text="Need Help?"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

</FrameLayout>